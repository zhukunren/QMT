# Copy to .env. Never commit credentials. Defaults allow local development only.
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
PYTHON_PATH=python
ENABLE_CODEX=true

# Official @openai/codex-sdk; use a dedicated service account in production.
# Existing server-side Codex CLI login is supported when keys are omitted.
# CODEX_API_KEY=
# CODEX_MODEL=
# CODEX_PATH=

# Required (32+ characters) for external listening and NODE_ENV=production.
# API_TOKEN=
# Absolute storage path; default is <project>/data.
# DATA_DIR=
